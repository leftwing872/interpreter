# AWS credentials: uses the default credential chain (AWS_PROFILE, env vars, SSO, ...)
# AWS_PROFILE=default

# Region for Amazon Transcribe streaming
AWS_REGION=ap-northeast-2

# Region + model for Amazon Bedrock (Claude)
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
# Faster model asked in parallel when the main one has no first token after HEDGE_AFTER_MS (or fails). Empty = off.
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-haiku-5-5
HEDGE_AFTER_MS=1800
# No model answered within this long: the line is shown as failed and the session moves on.
TRANSLATE_DEADLINE_MS=12000
# Translation effort: low (fastest) | medium | high
TRANSLATE_EFFORT=low

PORT=3000

# Optional shared secret. When set, the UI asks for it once and the WebSocket requires it.
# ACCESS_TOKEN=
